{
  "ci": {
    "collect": {
      "numberOfRuns": 3,
      "staticDistDir": ".",
      "settings": {
        "onlyCategories": ["performance"],
        "chromeFlags": "--no-sandbox --headless=new --disable-dev-shm-usage --disable-gpu",
        "skipAudits": ["bf-cache"]
      }
    },
    "assert": {
      "assertions": {
        "largest-contentful-paint": ["error", {"maxNumericValue": 2500, "aggregationMethod": "median-run"}],
        "cumulative-layout-shift": ["error", {"maxNumericValue": 0.1, "aggregationMethod": "median-run"}],
        "total-byte-weight": ["error", {"maxNumericValue": 2097152, "aggregationMethod": "median-run"}],
        "uses-optimized-images": ["error", {"maxLength": 0}],
        "uses-responsive-images": ["error", {"maxLength": 0}],
        "modern-image-formats": ["warn", {"maxLength": 0}],
        "unsized-images": ["warn", {"maxLength": 0}]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "lhci-report"
    }
  }
}
